{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug Backend (Spring Boot)",
            "request": "launch",
            "mainClass": "com.skillsphere.SkillSphereApplication",
            "projectName": "skillsphere-backend",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "JAVA_HOME": "C:\\Program Files\\Java\\jdk-25"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Frontend (Chrome)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "Start Frontend (Vite React)"
        }
    ],
    "compounds": [
        {
            "name": "Run Full Stack (Debug Backend + Frontend)",
            "configurations": [
                "Debug Backend (Spring Boot)",
                "Launch Frontend (Chrome)"
            ]
        }
    ]
}
