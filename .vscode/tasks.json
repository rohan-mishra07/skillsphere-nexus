{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend (Spring Boot)",
            "type": "shell",
            "command": "powershell -Command \"$env:JAVA_HOME='C:\\Program Files\\Java\\jdk-25'; .\\mvnw.cmd spring-boot:run\"",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "backend"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Frontend (Vite React)",
            "type": "shell",
            "command": "cmd /c npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Full Stack (Backend + Frontend)",
            "dependsOn": [
                "Start Backend (Spring Boot)",
                "Start Frontend (Vite React)"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
